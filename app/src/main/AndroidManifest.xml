<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 選用：若使用者另外開了「點亮螢幕」，亮屏會更穩；沒開也能用（改用透明亮屏畫面） -->
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.IdleMate">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 鎖定後把螢幕點亮的透明小畫面 -->
        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.IdleMate.Wake"
            android:turnScreenOn="true" />

        <!-- 協助工具：邊緣把手、全黑遮罩、鎖定螢幕、偵測前景 App（不讀取畫面內容） -->
        <service
            android:name=".IdleAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
